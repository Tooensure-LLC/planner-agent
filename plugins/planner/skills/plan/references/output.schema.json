{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "planner planner.plan frame",
  "type": "object",
  "required": [
    "frame_id",
    "trail_id",
    "cycle_id",
    "seq",
    "role",
    "kind",
    "parent_id",
    "prev_hash",
    "hash",
    "status",
    "payload"
  ],
  "properties": {
    "frame_id": {
      "type": "string",
      "minLength": 1
    },
    "trail_id": {
      "type": "string",
      "minLength": 1
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "role": {
      "const": "planner"
    },
    "kind": {
      "const": "planner.plan"
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "prev_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "hash": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "open",
        "complete",
        "blocked",
        "halted"
      ]
    },
    "payload": {
      "type": "object",
      "required": [
        "raw_seed",
        "true_intent",
        "assumptions",
        "flags",
        "plan_ref",
        "acceptance_criteria",
        "validated_resources",
        "steps"
      ],
      "properties": {
        "raw_seed": {
          "type": "string",
          "minLength": 1
        },
        "true_intent": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "plan_ref": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "validated_resources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
